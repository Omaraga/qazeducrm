# QazEduCRM - Local Development Environment
# Usage: cp .env.local .env && docker compose up -d

# ============ MySQL ============
DB_NAME=qazeducrm
DB_USER=qazeducrm
DB_PASS=secret
MYSQL_ROOT_PASSWORD=rootsecret

# ============ Yii2 ============
YII_DEBUG=true
YII_ENV=dev

# ============ PostgreSQL (Evolution API) ============
POSTGRES_PASSWORD=postgres

# ============ Evolution API (WhatsApp) ============
EVOLUTION_API_KEY=qazeducrm-local-api-key
EVOLUTION_SERVER_URL=http://localhost/whatsapp
